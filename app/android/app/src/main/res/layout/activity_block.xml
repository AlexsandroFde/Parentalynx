<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/block_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/block_icon_description"
            android:src="@drawable/ic_block_lock" />

        <TextView
            android:id="@+id/block_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/plx_on_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/block_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/plx_on_primary_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/block_release"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/plx_on_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/block_allowed_title"
                android:textColor="@color/plx_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/block_allowed_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/block_allowed_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/block_allowed_empty"
                android:textColor="@color/plx_text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/block_request"
            style="@style/BlockButton"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_primary"
            android:text="@string/block_request_time"
            android:textColor="@color/plx_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/block_request_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/plx_on_primary_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/block_emergency"
            style="@style/BlockButton"
            android:background="@drawable/btn_outline"
            android:text="@string/block_emergency"
            android:textColor="@color/plx_on_primary" />

        <Button
            android:id="@+id/block_guardian"
            style="@style/BlockButton"
            android:background="@drawable/btn_outline"
            android:text="@string/block_guardian"
            android:textColor="@color/plx_on_primary" />

        <Button
            android:id="@+id/block_home"
            style="@style/BlockButton"
            android:background="@drawable/btn_text"
            android:text="@string/block_home"
            android:textColor="@color/plx_on_primary_muted" />

        <TextView
            android:id="@+id/block_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/plx_on_primary_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
