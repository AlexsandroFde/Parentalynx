<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de bloqueio nativa, no visual do Design System (perfil da crianca): o motivo com um
     icone, quando o uso volta, o que continua liberado e as saidas (pedir tempo, emergencia,
     responsavel). O fundo muda para anil nos descansos combinados (horario e pausa). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_block"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_block_icon">

            <ImageView
                android:id="@+id/block_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@string/block_icon_description"
                android:src="@drawable/ic_block_lock" />
        </FrameLayout>

        <TextView
            android:id="@+id/block_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/manrope_extrabold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:textColor="@color/plx_on_dark"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/block_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/manrope_medium"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/plx_on_dark_muted"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/block_release"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:textColor="@color/plx_on_dark"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="@font/manrope_bold"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/block_allowed_title"
                android:textColor="@color/plx_text"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/block_allowed_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/block_allowed_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/manrope_medium"
                android:lineSpacingExtra="2dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/block_allowed_empty"
                android:textColor="@color/plx_text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/block_request"
            style="@style/BlockButton"
            android:layout_marginTop="28dp"
            android:background="@drawable/btn_primary"
            android:text="@string/block_request_time"
            android:textColor="@color/plx_primary" />

        <TextView
            android:id="@+id/block_request_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/manrope_medium"
            android:gravity="center"
            android:textColor="@color/plx_on_dark_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/block_emergency"
            style="@style/BlockButton"
            android:background="@drawable/btn_outline"
            android:text="@string/block_emergency"
            android:textColor="@color/plx_on_dark" />

        <Button
            android:id="@+id/block_guardian"
            style="@style/BlockButton"
            android:background="@drawable/btn_outline"
            android:text="@string/block_guardian"
            android:textColor="@color/plx_on_dark" />

        <Button
            android:id="@+id/block_home"
            style="@style/BlockButton"
            android:background="@drawable/btn_text"
            android:text="@string/block_home"
            android:textColor="@color/plx_on_dark_muted" />

        <TextView
            android:id="@+id/block_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/manrope_medium"
            android:gravity="center"
            android:textColor="@color/plx_on_dark_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
