    <!-- Petroleo: a marca e a cor de acao. -->
    <color name="plx_primary">#136874</color>
    <!-- Fundo da tela de bloqueio: petroleo bem escuro, solido. -->
    <color name="plx_primary_deep">#0E2A2F</color>
    <color name="plx_primary_ink">#082F36</color>
    <color name="plx_primary_soft">#D5E8EA</color>
    <!-- Anil: descanso combinado (hora de dormir, pausa). Nao e erro. -->
    <color name="plx_rest">#362F78</color>
    <color name="plx_rest_deep">#1E1B38</color>
    <!-- Ambar: so o simbolo da marca. -->
    <color name="plx_brand_accent">#E59B32</color>
    <!-- Texto e contornos sobre os fundos escuros da tela de bloqueio. -->
    <color name="plx_on_dark">#FFFFFF</color>
    <color name="plx_on_dark_muted">#C4C4CC</color>
    <color name="plx_on_dark_outline">#59FFFFFF</color>
    <color name="plx_on_dark_line">#33FFFFFF</color>
    <color name="plx_on_dark_soft">#1AFFFFFF</color>
    <!-- Superficies e texto do cartao (grafite do tema claro). -->
    <color name="plx_surface">#FFFFFF</color>
    <color name="plx_text">#17171A</color>
    <color name="plx_text_muted">#5C5C66</color>
</resources>
