<resources>
    <string name="app_name">ParentaLynx</string>
    <string name="browser_label">Navegador ParentaLynx</string>

    <!-- Serviço de acessibilidade: divulgação destacada do que ele faz e do que não faz. -->
    <string name="accessibility_label">Controle parental ParentaLynx</string>
    <string name="accessibility_summary">Identifica o app aberto para aplicar as regras definidas pelo responsável.</string>
    <string name="accessibility_description">O ParentaLynx usa este serviço somente para saber qual aplicativo está aberto e para fechar um aplicativo bloqueado pelo responsável.\n\nEste serviço não lê o conteúdo das telas, não registra o que é digitado, não acessa senhas nem mensagens.\n\nSe ele for desativado, o responsável é avisado.</string>

    <!-- Administrador do dispositivo. -->
    <string name="device_admin_label">Controle parental ParentaLynx</string>
    <string name="device_admin_description">Impede que o controle parental seja desinstalado sem o conhecimento do responsável.</string>
    <string name="device_admin_explanation">Com o administrador ativo, o ParentaLynx só pode ser desinstalado depois de desativado aqui, e o responsável é avisado quando isso acontece.</string>
    <string name="device_admin_disable_warning">Se você desativar o administrador, o controle parental poderá ser desinstalado. O responsável será avisado.</string>
    <string name="owner_support_short">Bloqueado pelo controle parental ParentaLynx. Fale com o seu responsável.</string>
    <string name="owner_support_long">Este aparelho é gerenciado pelo controle parental ParentaLynx. O aplicativo ou a configuração está bloqueado pelas regras definidas pelo responsável: limite diário de uso, horário permitido ou bloqueio do aplicativo. Para liberar, fale com o seu responsável.</string>
    <string name="fgs_special_use">Controle parental: conta o tempo de uso e aplica as regras definidas pelo responsável.</string>

