# Copie para .env e ajuste. O arquivo .env nunca deve ser versionado.

# Dominio publico da API, usado pelo Caddy para o certificado HTTPS (so no docker-compose).
DOMAIN=api.exemplo.com.br

# Chave da cifra de campos sensiveis: base64 de 32 bytes. OBRIGATORIA em producao.
# Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Guarde uma copia fora do servidor. Sem ela, enderecos de navegacao, dados de eventos, alertas
# e os segredos de acesso offline ficam ilegiveis.
DATA_ENCRYPTION_KEY=

# production exige DATA_ENCRYPTION_KEY. Qualquer outro valor e tratado como desenvolvimento.
NODE_ENV=production

# Porta e endereco de escuta.
PORT=8080
HOST=0.0.0.0

# Arquivo do banco SQLite.
DATABASE_PATH=./data/parentalynx.db

# true quando ha um proxy reverso na frente (Caddy, Nginx). Faz o limite por IP usar o endereco
# real do cliente. Deixe false se o servidor recebe conexoes diretas.
TRUST_PROXY=false

# Nivel de log: fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# Validade da sessao do responsavel sem uso, em dias.
SESSION_TTL_DAYS=30

# Por quantos minutos a senha confirmada libera as operacoes administrativas.
ELEVATION_MINUTES=15

# Validade do codigo de vinculacao, em minutos.
PAIRING_CODE_TTL_MINUTES=15
