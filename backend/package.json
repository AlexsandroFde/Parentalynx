{
  "name": "parentalynx-backend",
  "version": "1.0.0",
  "description": "Backend do ParentaLynx: contas, vinculacao, politica, sincronizacao, relatorios e alertas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "simulate": "node scripts/simulate-device.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
